         <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Segoe UI',Arial; font-size:11pt;&quot;&gt;
&lt;div align=&quot;center&quot;&gt;
&lt;h1 style=&quot;color:#1A237E;&quot;&gt;MEMORIAL DE CÁLCULO DE RIGGING&lt;/h1&gt;
&lt;h3 style=&quot;color:#29B6F6;&quot;&gt;Plano de Rigging nº 001 - Operação Especial&lt;/h3&gt;
&lt;/div&gt;
&lt;hr style=&quot;border:1px solid #1A237E;&quot;/&gt;
&lt;p&gt;&lt;b&gt;Projeto:&lt;/b&gt; RigPlan Integrator v1.0&lt;br/&gt;
&lt;b&gt;Engenheiro Responsável:&lt;/b&gt; Equipe de Rigging&lt;br/&gt;
&lt;b&gt;Data:&lt;/b&gt; 2026-09-14&lt;/p&gt;
&lt;table border=&quot;1&quot; width=&quot;100%&quot; cellpadding=&quot;6&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse; border:1px solid #B0BEC5;&quot;&gt;
&lt;tr style=&quot;background-color:#1A237E; color:#FFFFFF;&quot;&gt;
&lt;th&gt;Item&lt;/th&gt;&lt;th&gt;Parâmetro de Rigging&lt;/th&gt;&lt;th&gt;Valor de Entrada&lt;/th&gt;&lt;th&gt;Resultado Calculado&lt;/th&gt;
&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Carga Útil Líquida&lt;/td&gt;&lt;td&gt;M_cargo = 15.000 kg, M_rigging = 450 kg&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#2E7D32;&quot;&gt;15.450 kgf&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr style=&quot;background-color:#F5F5F5;&quot;&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;Capacidade Bruta do Guindaste&lt;/td&gt;&lt;td&gt;Raio = 18m, Lança = 35m&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#2E7D32;&quot;&gt;28.500 kgf&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Fator de Utilização&lt;/td&gt;&lt;td&gt;Carga / Capacidade&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;color:#1565C0;&quot;&gt;54.21 % (SEGURO)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
