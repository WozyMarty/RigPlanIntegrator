dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../../resources/resources.qrc $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/qt6/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../../src/mainwindow.h ../../src/utils/constants.h ../../src/utils/datavalidator.h ../../src/utils/expressionevaluator.h ../../src/models/riggingcalculation.h ../../src/models/formatpreset.h ../../src/models/calculationpreset.h ../../src/models/presetmanager.h ../../src/core/calculationengine.h ../../src/core/documentgenerator.h ../../src/core/pdfexporter.h ../../src/core/docxexporter.h ../../src/widgets/headerbar.h ../../src/widgets/calculationblock.h ../../src/widgets/calculationpanel.h ../../src/widgets/documentpreview.h ../../src/widgets/presetcard.h ../../src/widgets/presetgallery.h ../../src/widgets/preseteditor.h ../../src/widgets/customcalcdialog.h ../../src/widgets/calculationpresetdialog.h ../../src/models/riggingplandata.h ../../src/widgets/riggingplandatadialog.h ../../src/models/documentsection.h ../../src/utils/aivalidator.h ../../src/widgets/pageorderdialog.h ../../src/widgets/exportdialog.h ../../src/widgets/aivalidatordialog.h ../../src/models/craneprofile.h ../../src/models/cranemanager.h ../../src/widgets/craneselectiondialog.h $(DISTDIR)/
	$(COPY_FILE) --parents ../../src/main.cpp ../../src/mainwindow.cpp ../../src/utils/datavalidator.cpp ../../src/utils/expressionevaluator.cpp ../../src/models/riggingcalculation.cpp ../../src/models/formatpreset.cpp ../../src/models/calculationpreset.cpp ../../src/models/presetmanager.cpp ../../src/core/calculationengine.cpp ../../src/core/documentgenerator.cpp ../../src/core/pdfexporter.cpp ../../src/core/docxexporter.cpp ../../src/widgets/headerbar.cpp ../../src/widgets/calculationblock.cpp ../../src/widgets/calculationpanel.cpp ../../src/widgets/documentpreview.cpp ../../src/widgets/presetcard.cpp ../../src/widgets/presetgallery.cpp ../../src/widgets/preseteditor.cpp ../../src/widgets/customcalcdialog.cpp ../../src/widgets/calculationpresetdialog.cpp ../../src/models/riggingplandata.cpp ../../src/widgets/riggingplandatadialog.cpp ../../src/models/documentsection.cpp ../../src/utils/aivalidator.cpp ../../src/widgets/pageorderdialog.cpp ../../src/widgets/exportdialog.cpp ../../src/widgets/aivalidatordialog.cpp ../../src/models/craneprofile.cpp ../../src/models/cranemanager.cpp ../../src/widgets/craneselectiondialog.cpp $(DISTDIR)/
