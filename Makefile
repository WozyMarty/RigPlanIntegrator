	$(COPY_FILE) --parents src/main.cpp src/mainwindow.cpp src/utils/datavalidator.cpp src/utils/expressionevaluator.cpp src/models/riggingcalculation.cpp src/models/formatpreset.cpp src/models/calculationpreset.cpp src/models/presetmanager.cpp src/core/calculationengine.cpp src/core/documentgenerator.cpp src/core/pdfexporter.cpp src/core/docxexporter.cpp src/widgets/headerbar.cpp src/widgets/calculationblock.cpp src/widgets/calculationpanel.cpp src/widgets/documentpreview.cpp src/widgets/presetcard.cpp src/widgets/presetgallery.cpp src/widgets/preseteditor.cpp src/widgets/customcalcdialog.cpp src/widgets/calculationpresetdialog.cpp src/models/riggingplandata.cpp src/widgets/riggingplandatadialog.cpp src/models/documentsection.cpp src/utils/aivalidator.cpp src/widgets/pageorderdialog.cpp src/widgets/exportdialog.cpp src/widgets/aivalidatordialog.cpp src/models/craneprofile.cpp src/models/cranemanager.cpp src/widgets/craneselectiondialog.cpp $(DISTDIR)/
